# Aivory Mail — Environment
PORT=8095
MAIL_MODE=vps
# vps | cloudflare | hybrid  (cloudflare = use Cloudflare Email Routing + Sending, vps = own SMTP + storage)
DATABASE_URL=postgresql://postgres:password@db:5432/aivory_mail
# For local/dev: DATABASE_URL=sqlite://./data/mail.db
# For Cloudflare D1 via HTTP: use DATABASE_URL=sqlite::memory: + D1 binding (worker mode)

STORAGE_BACKEND=local
# local | r2 | s3
STORAGE_BUCKET=aivory-mail
STORAGE_PATH=./data/mail-storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

JWT_SECRET=change-me-openssl-rand-hex-32
INTERNAL_TOKEN=aivory-internal-2026-change-me

# Cloudflare (only if MAIL_MODE=cloudflare|hybrid)
CF_API_TOKEN=
CF_ZONE_ID=
CF_EMAIL_WORKER_NAME=aivory-mail-worker

# SMTP outbound (VPS mode)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Inbound SMTP ingress (VPS)
SMTP_INGRESS_PORT=2525
AIVORY_MAIL_API_URL=http://avry-mail:8095

# AI / Workflow (Cerveau / Aivory Intelligence)
AI_GATEWAY_URL=http://avry-zeroclaw-daemon:3010
WORKFLOW_URL=http://avry-n8n-as-code:3500
ZEROCLAW_URL=http://avry-zeroclaw-daemon:3010
N8N_AS_CODE_URL=http://avry-n8n-as-code:3500

CORS_ORIGINS=https://aivory.id,https://dashboard.aivory.id,https://admin.aivory.id,https://mail.aivory.id
